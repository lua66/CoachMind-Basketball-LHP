{
  "entities": {
    "coaches": {
      "title": "Coaches",
      "description": "Coach user profile, subscription status and team settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "teamName": { "type": "string text" },
        "category": { "type": "string" },
        "clubName": { "type": "string" },
        "isSubscribed": { "type": "boolean" },
        "subscriptionDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "coaches/{coachId}/philosophy": {
      "title": "Coach Philosophy",
      "description": "Tactical philosophy and identity of the coach",
      "type": "object",
      "properties": {
        "playStyle": { "type": "string text" },
        "offensiveFocus": { "type": "string text" },
        "defensiveFocus": { "type": "string text" },
        "trainingGoals": { "type": "string text" },
        "matchGoals": { "type": "string text" },
        "coreValues": { "type": "string text" },
        "additionalNotes": { "type": "string text" }
      }
    },
    "coaches/{coachId}/players": {
      "title": "Players",
      "description": "Roster of players for this coach",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "number": { "type": "number" },
        "position": { "type": "string" },
        "height": { "type": "string" },
        "notes": { "type": "string text" },
        "stats": { "type": "object" }
      }
    },
    "coaches/{coachId}/trainings": {
      "title": "Trainings",
      "description": "Training sessions generated or created",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "duration": { "type": "number" },
        "focus": { "type": "string" },
        "drills": { "type": "array" },
        "notes": { "type": "string text" }
      }
    },
    "coaches/{coachId}/calendarEvents": {
      "title": "Calendar Events",
      "description": "Matches, practices, and events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "opponent": { "type": "string" }
      }
    },
    "coaches/{coachId}/savedPlays": {
      "title": "Saved Tactical Plays",
      "description": "Saved chalkboard plays and animations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "players": { "type": "array" },
        "arrows": { "type": "array" },
        "description": { "type": "string text" }
      }
    }
  }
}
